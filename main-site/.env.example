# What the site's serverless functions (api/) read. On Vercel, set these in the project's
# Settings > Environment Variables (Production, marked Sensitive), then redeploy. For `vercel dev`,
# copy this file to .env (ignored by git) and fill it in. Never commit real values.
#
# Every one is optional: without it, its feature is off and the rest of the site works.

# --- Report a bug (api/bug-report.js; BUG-REPORT-SETUP.md) ---
# The Telegram bot that sends reports, from @BotFather's /newbot.
BUG_REPORT_BOT_TOKEN=
# Where reports go: one chat or several, split by commas. A private chat (424242), a group
# (-1001234567890), a topic in one (-1001234567890/17), or a public channel (@channelname).
BUG_REPORT_CHAT_ID=

# --- Android notifications (api/push/release.js, api/_push/fcm.js; flutter/FIREBASE-SETUP.md) ---
# uwuFix's Firebase service account key: the whole JSON file, on one line, or base64 of it.
FIREBASE_SERVICE_ACCOUNT=
# The secret GitHub's "release published" webhook is signed with. Make one with:
#   PowerShell: $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { '{0:x2}' -f $_ })
GITHUB_WEBHOOK_SECRET=

# --- Update checks (api/app-release.js, api/_release.js) ---
# A fine-grained GitHub token with Public repositories (read-only) and nothing else. Without it,
# GitHub allows 60 requests an hour, which the site's cache makes plenty.
GITHUB_TOKEN=
