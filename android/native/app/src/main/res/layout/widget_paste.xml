<?xml version="1.0" encoding="utf-8"?>
<!-- The "Fix copied link" widget (Widgets.Paste): the bar's paste button on its own, a circle in
     the middle of its cell, whatever shape the cell is. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_paste"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/widget_paste_name"
        android:padding="15dp"
        android:src="@drawable/ic_widget_paste" />
</FrameLayout>
