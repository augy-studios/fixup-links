<?xml version="1.0" encoding="utf-8"?>
<!-- The "Fix copied link" widget (Widgets.Paste): one cell. Nothing on it changes, so it never
     refreshes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_paste_description"
    android:initialLayout="@layout/widget_paste"
    android:previewLayout="@layout/widget_paste"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
